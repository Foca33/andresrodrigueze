# URL pública final (canonical, OG, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.andresrodrigueze.com
# false = noindex (default). Pon true el día del lanzamiento.
NEXT_PUBLIC_INDEXABLE=false
# true = muestra las etiquetas ámbar de "PROVISIONAL / PLACEHOLDER". Pon false al lanzar.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
# Ruta del formulario de correo. En producción (Netlify): /api/subscribe
# Vacío = simula éxito sin guardar el correo (útil en local/preview).
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# --- Solo servidor (sin prefijo NEXT_PUBLIC_: nunca llegan al navegador) ---
# Brevo → ícono de engranaje → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=
# Brevo → Contacts → Lists → abre tu lista → el id numérico aparece en la URL
BREVO_LIST_ID=
